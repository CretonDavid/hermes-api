# Copier en .env puis remplir. Ne jamais commiter .env.

# Mot de passe de la base (au choix, sans espace)
DB_PASSWORD=
# Clé de signature des jetons de connexion : générer avec   openssl rand -base64 48
JWT_SECRET=

# Port d'accès à Hermès sur le serveur : http://<serveur>:8090
HERMES_PORT=8090
# Dossier du dépôt hermes-app, relatif à ce dossier deploy
HERMES_APP_DIR=../../hermes-app

TZ=Europe/Paris
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=30
# Dossier des sauvegardes sur le serveur
BACKUP_DIR=./backups
